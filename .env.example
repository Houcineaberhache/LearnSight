# =============================================================================
# LearnSight — Variables d'environnement (exemple)
# =============================================================================
# Copier ce fichier en .env et adapter les valeurs selon votre environnement.
# NE JAMAIS commiter le fichier .env dans Git !
# =============================================================================

# -----------------------------------------------------------------------------
# Kafka
# -----------------------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
KAFKA_TOPIC_CLICS_VLE=clics_vle
KAFKA_TOPIC_EVALUATIONS=evaluations

# Délai entre deux événements rejoués par les producteurs (secondes)
INGESTION_DELAY=0.01

# -----------------------------------------------------------------------------
# MinIO — Stockage objet compatible S3
# -----------------------------------------------------------------------------
MINIO_ROOT_USER=learnsight
MINIO_ROOT_PASSWORD=learnsight123
MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET_BRONZE=learnsight-bronze
MINIO_BUCKET_SILVER=learnsight-silver
MINIO_BUCKET_GOLD=learnsight-gold

# -----------------------------------------------------------------------------
# Spark
# -----------------------------------------------------------------------------
SPARK_MASTER_URL=spark://localhost:7077

# -----------------------------------------------------------------------------
# PostgreSQL — Métadonnées Airflow & Superset
# -----------------------------------------------------------------------------
POSTGRES_DB=learnsight
POSTGRES_USER=learnsight
POSTGRES_PASSWORD=learnsight123
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# -----------------------------------------------------------------------------
# Airflow
# -----------------------------------------------------------------------------
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://learnsight:learnsight123@localhost:5432/airflow
# Générer via : python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW__CORE__FERNET_KEY=your_fernet_key_here
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=admin

# -----------------------------------------------------------------------------
# Superset
# -----------------------------------------------------------------------------
# Générer via : python -c "import secrets; print(secrets.token_hex(32))"
SUPERSET_SECRET_KEY=your_superset_secret_key_here
